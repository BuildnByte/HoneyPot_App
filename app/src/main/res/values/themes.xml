<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!-- HONEYPOT BASE THEME v2                                             -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary = accent_blue everywhere Material3 uses primary -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorTertiary">@color/accent_green</item>
        <item name="colorError">@color/accent_red</item>

        <!-- Surfaces — dark navy palette -->
        <item name="colorSurface">@color/bg_primary</item>
        <item name="colorSurfaceContainer">@color/bg_card</item>
        <item name="colorSurfaceContainerHigh">@color/bg_elevated</item>
        <item name="colorSurfaceVariant">@color/bg_elevated</item>

        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutlineVariant">@color/divider_color</item>

        <item name="colorPrimaryContainer">@color/badge_blue_bg</item>
        <item name="colorOnPrimaryContainer">@color/accent_blue</item>
        <item name="colorTertiaryContainer">@color/badge_green_bg</item>
        <item name="colorOnTertiaryContainer">@color/accent_green</item>
        <item name="colorErrorContainer">@color/badge_red_bg</item>
        <item name="colorOnErrorContainer">@color/accent_red</item>

        <!-- Status / nav bars -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_elevated</item>

        <!-- Text defaults -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Switches use accent_blue (not purple) when ON -->
        <item name="materialSwitchStyle">@style/Widget.Honeypot.Switch</item>

        <!-- Card default -->
        <item name="materialCardViewStyle">@style/Widget.Honeypot.Card</item>
    </style>

    <!-- ── Card — bg_card + 1dp card_stroke border ───────────────────── -->
    <style name="Widget.Honeypot.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
    </style>

    <!-- ── Switch — blue thumb/track, no purple ──────────────────────── -->
    <style name="Widget.Honeypot.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <!-- ── Buttons ────────────────────────────────────────────────────── -->
    <style name="Widget.Honeypot.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_blue</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.Honeypot.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_blue</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.Honeypot.Button.Action" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_surface</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- ── Typography ─────────────────────────────────────────────────── -->
    <style name="TextAppearance.Honeypot.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Section labels: 13sp sentence case, text_secondary, NOT all-caps -->
    <style name="TextAppearance.Honeypot.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Honeypot.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Honeypot.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Honeypot.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- ── Chat bubble shapes ─────────────────────────────────────────── -->
    <style name="ShapeAppearance.ChatBubble.Attacker" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">14dp</item>
        <item name="cornerSizeBottomRight">14dp</item>
        <item name="cornerSizeBottomLeft">14dp</item>
        <item name="cornerSizeTopLeft">4dp</item>
    </style>

    <style name="ShapeAppearance.ChatBubble.Victim" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">14dp</item>
        <item name="cornerSizeBottomLeft">14dp</item>
        <item name="cornerSizeBottomRight">14dp</item>
        <item name="cornerSizeTopRight">4dp</item>
    </style>

    <!-- ── Badge styles ───────────────────────────────────────────────── -->
    <style name="Widget.Honeypot.Badge.Red" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:background">@drawable/bg_badge_red</item>
        <item name="android:textColor">@color/accent_red</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.Honeypot.Badge.Green" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:background">@drawable/bg_badge_green</item>
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.Honeypot.Badge.Blue" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:background">@drawable/bg_badge_blue</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- ── Bottom nav: no pill indicator ─────────────────────────────── -->
    <style name="Widget.Honeypot.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.None</item>
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- AI Honeypot outgoing reply — blue right-border bubble -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingStart="64dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- "AI Honeypot" label above bubble -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="3dp"
        android:text="AI Honeypot"
        android:textSize="10sp"
        android:textColor="@color/accent_blue"
        android:letterSpacing="0.04" />

    <!-- Bubble card with blue right border -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bubble_honeypot_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <!-- Message body -->
                <TextView
                    android:id="@+id/messageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.3" />

                <!-- Timestamp aligned right -->
                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="5dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:alpha="0.8" />
            </LinearLayout>

            <!-- 3dp blue right accent border -->
            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/accent_blue" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

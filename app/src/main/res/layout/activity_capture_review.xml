<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@android:id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Main Content: Top Bar + Full Screen Screenshot & Overlays -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar & Box Tools Header -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            app:elevation="4dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:title="Review capture"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:subtitle="Draw boxes or tap to select text" />

            <!-- Google Lens Bounding Box Tools Bar -->
            <LinearLayout
                android:id="@+id/boxToolsBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:background="?attr/colorSurface">

                <TextView
                    android:id="@+id/tvBoxHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/box_hint_zero"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearBoxes"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/clear_boxes"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoSelectIncoming"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/auto_select_incoming"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAll"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/select_all"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Screenshot overlay view (expands to take all remaining space) -->
        <com.example.myapplication.manualcapture.BlockOverlayView
            android:id="@+id/blockOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:contentDescription="Screenshot preview with text block overlays. Drag to draw bounding boxes or tap blocks." />
    </LinearLayout>

    <!-- Bottom Floating Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:paddingTop="8dp"
        android:clipToPadding="false">

        <!-- L/R Orientation Toggle Floating Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabOrientation"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:text="R"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:elevation="6dp"
            android:contentDescription="Toggle sender message orientation (L / R)" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Floating View Text Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabViewText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Text"
            android:contentDescription="View and edit selected message text"
            app:icon="@drawable/ic_message"
            app:elevation="6dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Floating Analyse Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnAnalyse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyse"
            android:enabled="false"
            android:contentDescription="Analyse selected text for scam indicators"
            app:icon="@drawable/ic_scan"
            app:elevation="6dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

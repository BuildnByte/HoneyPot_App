<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── App Bar ──────────────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        android:elevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetEnd="56dp"
                app:titleTextColor="@color/text_primary"
                app:subtitleTextColor="@color/text_secondary"
                app:title="Honeypot"
                app:subtitle="AI-powered scam protection"
                android:background="@color/bg_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="Open settings"
                android:padding="12dp"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/text_secondary"
                app:backgroundTint="@android:color/transparent" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HOME TAB                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- ── HERO STATUS CARD ──────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Green pulse dot -->
                        <View
                            android:id="@+id/statusPulseDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_badge_green"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Protection Active"
                            android:textColor="@color/accent_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="Shield active"
                            app:tint="@color/accent_green" />
                    </LinearLayout>

                    <!-- Big stat -->
                    <TextView
                        android:id="@+id/statMessagesScanned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="247 messages scanned"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="since you installed Honeypot"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider_color" />

                    <!-- Two inline stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_badge_red"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/statScamsCaught"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 scams caught"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_badge_green"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/statThreatsToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 threats today"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── QUICK ACTION CHIPS ────────────────────────────────────── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipScanMessage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingHorizontal="16dp"
                        android:text="Scan message"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/bg_elevated"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_scan"
                        app:iconTint="@color/text_secondary"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipViewThreats"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:paddingHorizontal="16dp"
                        android:text="View threats"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/bg_elevated"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_message"
                        app:iconTint="@color/accent_red"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipFileReport"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:paddingHorizontal="16dp"
                        android:text="File report"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@color/bg_elevated"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_history"
                        app:iconTint="@color/text_secondary"
                        app:iconSize="18dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── RECENT ACTIVITY SECTION LABEL ───────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="RECENT ACTIVITY"
                style="@style/TextAppearance.Honeypot.SectionLabel" />

            <!-- Recent activity list (inline live sessions — shows last 3 on home tab) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentActivityRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/recentActivityEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="No threats detected yet"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- ── HIDDEN DEBUG TOOLS ────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/advancedTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DEVELOPER TOOLS"
                    style="@style/TextAppearance.Honeypot.SectionLabel" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- resultText kept for diagnostics code -->
                        <TextView
                            android:id="@+id/resultText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:text="Checking…" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/testButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Run diagnostics"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/divider_color" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/injectSmsButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Inject test SMS"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/divider_color" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/directProcessButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Start processing service"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/divider_color" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/testSafeBrowsingButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Test Safe Browsing API"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/divider_color" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- keep legacy button IDs referenced by MainActivity -->
            <Button android:id="@+id/simulationButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <Button android:id="@+id/evidenceButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <Button android:id="@+id/liveHoneypotButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- THREATS TAB                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/messagesContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="120dp"
            android:paddingHorizontal="16dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- HISTORY TAB                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/historyContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Filter chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="All"
                    android:background="@drawable/bg_chip_active"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp" />

                <TextView
                    android:id="@+id/filterHighRisk"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:text="High Risk"
                    android:background="@drawable/bg_chip_neutral"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp" />

                <TextView
                    android:id="@+id/filterLowRisk"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:text="Low Risk"
                    android:background="@drawable/bg_chip_neutral"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp" />

                <TextView
                    android:id="@+id/filterReported"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:text="Reported"
                    android:background="@drawable/bg_chip_neutral"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/historySwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="120dp"
                android:paddingHorizontal="16dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/historyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="No history yet"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- keep legacy button ID -->
        <Button android:id="@+id/openHistoryButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SANDBOX TAB                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/sandboxContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sandboxRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="120dp"
            android:paddingHorizontal="16dp" />

        <TextView
            android:id="@+id/sandboxEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No testing sessions yet"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- FAB -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/openSandboxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:layout_marginBottom="88dp"
            android:text="New test session"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/accent_blue"
            app:icon="@drawable/ic_sandbox"
            app:iconTint="@color/text_primary" />
    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SCANS TAB                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/scansContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/scansRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="120dp"
            android:paddingHorizontal="16dp" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/scansEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_scan"
                android:contentDescription="No scans"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No scans yet"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tap the button below to scan a screenshot"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Empty text (legacy ID kept) -->
        <TextView
            android:id="@+id/scansEmptyText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- FAB -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/openScansButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:layout_marginBottom="88dp"
            android:text="+ Scan New Screenshot"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/accent_blue"
            app:iconTint="@color/text_primary" />
    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- BOTTOM NAVIGATION                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_elevated"
        android:elevation="0dp"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:itemRippleColor="@android:color/transparent"
        app:itemActiveIndicatorStyle="@style/Widget.Honeypot.BottomNav.Indicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

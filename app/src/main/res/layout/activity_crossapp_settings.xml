<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@android:id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:title="Scan message"
            app:subtitle="Cross-app suspicious message scanner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Shield icon and title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_scan"
                    android:contentDescription="@null"
                    android:tint="?attr/colorPrimary"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cross-app scanning"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Manually scan suspicious messages from WhatsApp, Telegram, or Instagram by taking a one-time screenshot."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Quick Settings Tile -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick Settings tile"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Add the \'Scan message\' tile to your notification shade for one-tap access."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Add \'Scan message\' Quick Setting"
                app:icon="@drawable/ic_scan" />

            <!-- Overlay status -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Scan overlay"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Overlay is disabled"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleOverlay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enable overlay" />

            <!-- Message layout preference -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Message layout"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tell Honeypot which side your own messages appear on."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <RadioGroup
                android:id="@+id/settingsLayoutGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <RadioButton
                    android:id="@+id/settingsRadioRightIsMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My messages appear on the Right (default)" />
                <RadioButton
                    android:id="@+id/settingsRadioLeftIsMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My messages appear on the Left (RTL)" />
            </RadioGroup>

            <!-- Allowed apps for scanning -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Allowed apps for scanning"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Control which applications Honeypot is allowed to capture."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <RadioGroup
                android:id="@+id/settingsAllowedAppsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <RadioButton
                    android:id="@+id/settingsRadioAllApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All apps (scan any chat screen)" />
                <RadioButton
                    android:id="@+id/settingsRadioSelectedApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected apps only" />
            </RadioGroup>
            <LinearLayout
                android:id="@+id/settingsSelectedAppsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="0dp"
                android:visibility="gone">
                <CheckBox
                    android:id="@+id/settingsCbWhatsApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp" />
                <CheckBox
                    android:id="@+id/settingsCbTelegram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telegram" />
                <CheckBox
                    android:id="@+id/settingsCbInstagram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instagram" />
            </LinearLayout>

            <!-- Supported apps -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Supported apps"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Layout detection has been verified for:\n• WhatsApp (one-to-one chats)\n• Telegram (one-to-one chats)\n• Instagram DMs\n\nOther apps can be scanned but sender-side inference may be unreliable."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Saved captures -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Saved captures"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Screenshots are stored in app-private storage and are not shared with any third party by default."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageCaptures"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Manage saved captures" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCaptures"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Clear all manual-capture evidence" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

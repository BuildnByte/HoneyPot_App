<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- Header for grouped entities (e.g. "PHONE", "URL") -->
    <TextView
        android:id="@+id/evidenceTypeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="PHONE NUMBERS"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_evidence_item"
        android:padding="12dp">
        
        <TextView
            android:id="@+id/evidenceValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            tools:text="Kunal Vasant Bhoir" />

        <TextView
            android:id="@+id/evidenceSourceLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Source Message:"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/evidenceSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            tools:text="Dear SBI User, your A/c X1134-credited by Rs.112.50 on 12Aug26 transfer from Kunal Vasant Bhoir..." />

        <!-- Badge for Cross-Session Fingerprinting -->
        <TextView
            android:id="@+id/evidenceSeenElsewhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/colorErrorContainer"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone"
            tools:text="🔗 Also seen in 2 other sessions"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>

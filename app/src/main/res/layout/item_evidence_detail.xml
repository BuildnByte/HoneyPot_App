<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <!-- Section header: icon + sentence-case label (replaces ALL_CAPS db fields) -->
    <LinearLayout
        android:id="@+id/evidenceTypeHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/evidenceTypeIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_history"
            android:contentDescription="Evidence type"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/evidenceTypeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textStyle="normal"
            tools:text="Financial Amounts" />
    </LinearLayout>

    <!-- Evidence value card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Main value (bold) -->
            <TextView
                android:id="@+id/evidenceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                tools:text="Kunal Vasant Bhoir" />

            <!-- Source label -->
            <TextView
                android:id="@+id/evidenceSourceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Source message"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />

            <!-- Source message text -->
            <TextView
                android:id="@+id/evidenceSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:lineSpacingMultiplier="1.3"
                tools:text="Dear SBI User, your A/c X1134 credited by Rs.112.50..." />

            <!-- "Also seen in" cross-reference chip — neutral, not alarming -->
            <LinearLayout
                android:id="@+id/evidenceSeenElsewhere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_neutral"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Cross reference"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/evidenceSeenElsewhereText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    tools:text="Also seen in: Manual Scan" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lensRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD000000"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="false">

    <!-- 1. Full-screen Screenshot & Interactive Bounding Box Overlay -->
    <com.example.myapplication.manualcapture.BlockOverlayView
        android:id="@+id/blockOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Freeze-frame screenshot. Touch and drag to draw bounding boxes or tap text to select." />

    <!-- 2. Top Control Bar (Google Lens style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="36dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardBackgroundColor="#E61E293B">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <!-- Dismiss Lens Button -->
            <ImageButton
                android:id="@+id/btnCloseLens"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white"
                android:contentDescription="Close scan overlay and return to app" />

            <TextView
                android:id="@+id/tvBoxHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Drag boxes or tap text to select"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Clear Boxes Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearBoxes"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingHorizontal="8dp"
                android:text="Clear"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Auto-Select Incoming Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoSelectIncoming"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingHorizontal="8dp"
                android:text="Auto"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <!-- Select All Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:paddingHorizontal="8dp"
                android:text="All"
                android:textColor="#F1F5F9"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Bottom Floating Action Dock -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="28dp"
        android:paddingTop="8dp"
        android:clipToPadding="false">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Floating View Text Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabViewText"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="View Text"
            android:textSize="13sp"
            app:icon="@drawable/ic_message"
            app:cornerRadius="24dp"
            app:elevation="8dp"
            android:contentDescription="Preview selected message text" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- Floating Analyze Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyse"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Analyze"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_scan"
            app:cornerRadius="24dp"
            app:elevation="10dp"
            android:contentDescription="Analyze selected messages for scam signals" />
    </LinearLayout>

    <!-- 4. Selected Text Preview Modal (Hidden by default) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSelectedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="90dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardBackgroundColor="#F81E293B"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Selected Message Text"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseSelectedText"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="#94A3B8"
                    android:contentDescription="Close selected text preview" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="220dp">

                <TextView
                    android:id="@+id/tvSelectedTextPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true"
                    android:focusable="false"
                    android:background="#330F172A"
                    android:padding="12dp" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. Floating In-Place Scam Analysis Card (Slides up over WhatsApp) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAnalysis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="20dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#33FFFFFF"
        app:cardBackgroundColor="#FA1E293B"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Loading Spinner State -->
            <LinearLayout
                android:id="@+id/layoutAnalysisProgress"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/brand_primary"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/tvAnalysisProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Scanning conversation for scam indicators…"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Analysis Result Content -->
            <LinearLayout
                android:id="@+id/layoutAnalysisContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Header: Risk Badge + Close Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Risk Badge Chip -->
                    <TextView
                        android:id="@+id/tvRiskBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_evidence_item"
                        android:backgroundTint="#EF4444"
                        android:text="⚠️ HIGH SCAM RISK"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="85% Confidence"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnCloseAnalysis"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        app:tint="#94A3B8"
                        android:contentDescription="Close scam analysis" />
                </LinearLayout>

                <!-- Scam Type -->
                <TextView
                    android:id="@+id/tvScamType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Type: Urgent Financial Fraud"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Reasoning & Red Flags -->
                <TextView
                    android:id="@+id/tvReasoning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="The message creates artificial urgency demanding immediate funds transfer or credentials."
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <!-- Triggers -->
                <TextView
                    android:id="@+id/tvTriggers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Triggers: Urgency, Payment Demand, Suspicious Link"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Recommended Safe Reply Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#2038BDF8"
                    app:cardBackgroundColor="#220284C7">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RECOMMENDED SAFE REPLY"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvSafeReply"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="I am verifying this directly with the official company before proceeding. Do not contact me further."
                            android:textColor="#F8FAFC"
                            android:textSize="13sp"
                            android:textIsSelectable="true"
                            android:lineSpacingExtra="2dp" />

                        <!-- One-Tap Copy Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyReply"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="Copy Safe Reply &amp; Done"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_copy"
                            app:cornerRadius="12dp"
                            android:contentDescription="Copy recommended safe reply to clipboard and close" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Footer / Secondary Action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDoneAnalysis"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dismiss Overlay"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>

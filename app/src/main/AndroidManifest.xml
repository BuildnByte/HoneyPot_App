<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access — required for Safe Browsing API and Gemini Cloud reply generation -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- SMS Permissions -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!-- Phone state -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <!-- Boot receiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:ignore="ForegroundServicePermission"/>

    <!-- Notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Required when declaring SMS/Call permissions -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false"/>

    <application
        android:name=".HoneypotApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SMS BroadcastReceiver -->
        <!-- NOTE: Do NOT add android:permission here. That attribute restricts who can SEND
             the broadcast TO this receiver. Since the OS itself sends SMS_RECEIVED, adding
             BROADCAST_SMS silently blocks all delivery on modern Android. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- Background processing service -->
        <service
            android:name=".service.SmsProcessingService"
            android:foregroundServiceType="dataSync"
            android:exported="false"/>

        <activity
            android:name=".ui.SessionListActivity"
            android:exported="false"
            android:label="Simulation Lab"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ui.SimulationActivity"
            android:exported="false"
            android:label="Simulation Lab"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ui.EvidenceActivity"
            android:exported="false"
            android:label="Evidence Vault"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ui.EvidenceDetailActivity"
            android:exported="false"
            android:label="Session Evidence"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ui.HoneypotConversationActivity"
            android:exported="false"
            android:label="Live Honeypot Conversation"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication" />

        <!-- FileProvider for sharing PDF reports -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
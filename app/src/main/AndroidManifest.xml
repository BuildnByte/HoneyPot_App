<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS Permissions -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>

    <!-- Phone state -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:ignore="ForegroundServicePermission"/>

    <!-- Notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Required when declaring SMS/Call permissions -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false"/>

    <application
        android:name=".HoneypotApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SMS BroadcastReceiver -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- Background processing service -->
        <service
            android:name=".service.SmsProcessingService"
            android:foregroundServiceType="dataSync"
            android:exported="false"/>

        <activity
            android:name=".ui.SimulationActivity"
            android:exported="false"
            android:label="Simulation Lab"
            android:theme="@style/Theme.MyApplication" />

        <activity
            android:name=".ui.EvidenceActivity"
            android:exported="false"
            android:label="Evidence Vault"
            android:theme="@style/Theme.MyApplication" />

    </application>

</manifest>